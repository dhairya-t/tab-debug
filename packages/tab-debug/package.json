{
  "name": "@dhairya-t/tab-debug",
  "version": "0.3.0",
  "description": "Page-specific WebMCP debugging tools for browser agents",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./webmcp": {
      "types": "./dist/webmcp.d.ts",
      "import": "./dist/webmcp.js"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "import": "./dist/replay.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    }
  },
  "bin": {
    "tab-debug": "./dist/cli.js"
  },
  "peerDependencies": {
    "react": ">=18",
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
