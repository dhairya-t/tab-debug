{
  "name": "tab-debug-demo",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --test packages/tab-debug/test/*.test.ts",
    "test:e2e": "playwright test",
    "build:sdk": "tsc -p packages/tab-debug/tsconfig.json",
    "check": "npm run typecheck && npm run test:unit && npm run build:sdk",
    "build:vercel": "next build",
    "dev:next": "next dev --port 3001",
    "start:next": "next start --port 3001",
    "test:webmcp": "node scripts/verify-webmcp.mjs",
    "test:export": "node scripts/verify-export.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@dhairya-t/tab-debug": "file:public/downloads/dhairya-t-tab-debug-0.3.0.tgz",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "^16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "agent-browser": "^0.37.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "^4.130.0"
  },
  "type": "module"
}
